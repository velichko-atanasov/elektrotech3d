"orange"

);


updateButtons();

}



/* ==========================================================
   СТЪПКА 3 – ПРОВЕРКА
   ========================================================== */

function step3(){

if(completed < 1){

showMessage(

`

<h2>
⚠ НЕ Е ИЗПЪЛНЕНО ОБЕЗОПАСЯВАНЕТО
</h2>

<p>
Преди проверката трябва да бъдат изпълнени
изключването и обезопасяването срещу повторно включване.
</p>

`,
"red"
);

return;

}


completed=
Math.max(
completed,
2
);


state.tested=true;


$("#currentStep")
.innerHTML=
"Стъпка 3 – Проверка за отсъствие на напрежение";


focus(
"focusTester"
);


$("#probeGlow")
.setAttribute(
"opacity","1"
);


$("#zeroIndicator")
.classList.add(
"show"
);


$("#instructionTitle")
.innerHTML=
"3. Проверка за отсъствие на напрежение";


$("#instructionText")
.innerHTML=
"Проверката се извършва с подходящ и предварително проверен уред на изводите и точките, по които ще се работи.";


$("#feedback")
.innerHTML=
"✓ Проверено е отсъствие на напрежение: 0 V.";


showMessage(

`

<h2>
🔍 ПРОВЕРКА ЗА ОТСЪСТВИЕ НА НАПРЕЖЕНИЕ
</h2>

<p>

Не се разчита само на положението
<strong>„ИЗКЛЮЧЕНО“</strong>
на прекъсвача.

</p>

<div class="rule">

Проверява се за отсъствие на напрежение
на изводите на изключения апарат
или на захранваното съоръжение,
в точките, по които ще се работи.

</div>

<p>

При трифазна система се проверяват
всички съответни фазови проводници,
както и необходимите комбинации
според конкретната схема.

</p>

<div class="veryImportant">

0 V трябва да бъде установено с ИЗПРАВЕН уред.

</div>

<p>

Работоспособността на указателя/уреда
се проверява преди използването му.

</p>

`,
"green"

);


updateButtons();

}



/* ==========================================================
   СТЪПКА 4 – ЛПС
   ========================================================== */

function step4(){

if(completed < 2){

showMessage(

`

<h2>
⚠ ПЪРВО ПРОВЕРЕТЕ ЗА ОТСЪСТВИЕ НА НАПРЕЖЕНИЕ
</h2>

`,
"red"
);

return;

}


completed=
Math.max(
completed,
3
);


state.ppe=true;


$("#currentStep")
.innerHTML=
"Стъпка 4 – ЛПС и подходящи инструменти";


focus(
"focusPPE"
);


$("#ppeLabel")
.classList.add(
"show"
);


$("#instructionTitle")
.innerHTML=
"4. Лични предпазни средства и инструменти";


$("#instructionText")
.innerHTML=
"Използват се подходящи ЛПС и само технически изправни инструменти.";


$("#feedback")
.innerHTML=
"✓ ЛПС и инструментите са проверени.";


showMessage(

`

<h2>
🦺 ЛПС И ИНСТРУМЕНТИ
</h2>

<p>

Използват се средствата,
необходими за конкретната работа
и определени според риска.

</p>

<div class="rule">

• защитна каска;<br>

• защитни очила;<br>

• подходящи ръкавици;<br>

• работно облекло;<br>

• защитни обувки;<br>

• изправни изолирани инструменти.

</div>

<div class="veryImportant">

Личните предпазни средства
не заменят изключването и проверката
за отсъствие на напрежение.

</div>

`,
"green"

);


updateButtons();

}



/* ==========================================================
   СТЪПКА 5 – ОГРАЖДАНЕ
   ========================================================== */

function step5(){

if(completed < 3){

showMessage(

`

<h2>
⚠ ИЗПЪЛНЕТЕ ПРЕДХОДНИТЕ ДЕЙСТВИЯ
</h2>

`,
"red"
);

return;

}


completed=4;


state.barrier=true;


$("#currentStep")
.innerHTML=
"Стъпка 5 – Ограждане и сигнализация";


focus(
"focusBarrier"
);


$("#barrierLabel")
.classList.add(
"show"
);


$("#instructionTitle")
.innerHTML=
"5. Ограждане и сигнализация";


$("#instructionText")
.innerHTML=
"Работното място се обозначава и се предотвратява достъпът до опасни или оставащи под напрежение части.";


$("#feedback")
.innerHTML=
"✓ Работното място е подготвено за безопасна работа.";


showMessage(

`

<h2>
🚧 ОГРАЖДАНЕ И СИГНАЛИЗАЦИЯ
</h2>

<p>

Обозначава се ясно границата
на работното място.

</p>

<div class="rule">

Оставащите под напрежение части
трябва да бъдат ясно различими
и при необходимост защитени
с подходящи ограждения или прегради.

</div>

<p>

Не се допуска неоторизиран достъп
до работната зона.

</p>

<div class="veryImportant">

✓ Едва след изпълнение на необходимите
мерки може да се започне работа.

</div>

`,
"purple"

);


updateButtons();

}



/* ==========================================================
   BUTTON EVENTS
   ========================================================== */

document
.querySelectorAll(
"[data-step]"
)
.forEach(
button=>{

button.addEventListener(
"click",
function(){

const step=
Number(
this.dataset.step
);


document
.querySelectorAll(
"[data-step]"
)
.forEach(
b=>b.classList.remove(
"active"
)
);


this.classList.add(
"active"
);


if(step===0)
step1();


if(step===1)
step2();


if(step===2)
step3();


if(step===3)
step4();


if(step===4)
step5();

}
);

}
);



/* ==========================================================
   RESET
   ========================================================== */

$("#resetBtn")
.addEventListener(
"click",
function(){

completed=-1;


state.powerOff=false;
state.locked=false;
state.tested=false;
state.ppe=false;
state.barrier=false;


$("#energyFlow")
.classList.remove(
"off"
);


$("#powerStatus")
.innerHTML=
"Захранване: ВКЛ.";


$("#powerStatus")
.classList.remove(
"off"
);


$("#currentStep")
.innerHTML=
"Изходно състояние – електрическото табло е под напрежение";


$("#instructionTitle")
.innerHTML=
"Започнете с „1. Изключване“";


$("#instructionText")
.innerHTML=
"Преди започване на работа определете веригата и всички възможни източници на захранване.";


$("#feedback")
.innerHTML="";


clearFocus();


$("#zeroIndicator")
.classList.remove(
"show"
);


$("#lockSymbol")
.classList.remove(
"show"
);


$("#ppeLabel")
.classList.remove(
"show"
);


$("#barrierLabel")
.classList.remove(
"show"
);


$("#probeGlow")
.setAttribute(
"opacity","0"
);


hideMessage();


document
.querySelectorAll(
"[data-step]"
)
.forEach(
b=>b.classList.remove(
"active",
"completed"
)
);

}
);


</script>

